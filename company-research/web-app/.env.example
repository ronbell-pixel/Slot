# Required: Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Access codes. Give each person their own code so usage is tracked per person:
#   ACCESS_CODES=Ron=nw-xxxx;Jane Doe=nw-yyyy
# ACCESS_CODE is an optional shared code, tracked as "Team".
ACCESS_CODES=
ACCESS_CODE=
# Opens the usage page at /admin.html
ADMIN_CODE=
# USER_MONTHLY_LIMIT=25         # lookups per person per month (0 or unset = no limit)
# DATA_DIR=/data                # where the usage log is kept; point at a Railway volume

# Recommended: SOS Finder key for official state registry data (sosfinder.com → Dashboard → API keys).
# Without it the app falls back to web search for the registry step.
SOS_API_KEY=
# SOS_MAX_CALLS_PER_LOOKUP=3    # registry credits a single report may use

# Optional tuning
# CLAUDE_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 (about half the cost) or claude-haiku-5-5 (cheapest)
# CLAUDE_EFFORT=medium          # low | medium | high — higher is more thorough and costs more
# MAX_WEB_SEARCHES=12           # per lookup
# MAX_WEB_FETCHES=8             # per lookup
# RATE_LIMIT_PER_HOUR=30        # lookups per IP per hour (0 = unlimited)

# Local preview with sample data and no API key:
# MOCK_REPORT_FILE=test/fixtures/sample-report.json
